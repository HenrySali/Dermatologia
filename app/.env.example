# =============================================================================
# CONFIGURACIÓN DE AMBIENTE - Dermatología Dra. Stefany Salinas
# =============================================================================
# IMPORTANTE: Renombra este archivo a .env y completa los valores
# Este archivo NO debe ser commiteado a GitHub (está en .gitignore)
# =============================================================================

# ============================================================================
# 🔑 SEGURIDAD
# ============================================================================

# JWT Secret - Clave para firmar tokens de autenticación
# Genera una clave aleatoria fuerte: openssl rand -base64 32
JWT_SECRET=tu_clave_secreta_super_segura_cambiar_en_produccion_12345

# Puerto en el que corre la aplicación
PORT=3000

# ============================================================================
# 📧 SENDGRID - Configuración de Emails
# ============================================================================

# SENDGRID_API_KEY: Obtén tu clave en https://sendgrid.com
# 1. Crea una cuenta en SendGrid (gratis hasta 100 emails/día)
# 2. Ve a Dashboard > Settings > API Keys
# 3. Crea una API Key (Full Access o Mail Send access)
# 4. Copia aquí tu clave: SG.xxxxxxxxxxxxxxxxxxxxxx
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email desde donde se enviarán los correos
# Debe ser un dominio verificado en SendGrid
EMAIL_FROM=contacto@dermatologia-stefany.com

# Email del admin (recibe notificaciones de nuevos turnos)
EMAIL_ADMIN=admin@dermatologia-stefany.com

# ============================================================================
# 🌐 APLICACIÓN
# ============================================================================

# URL base de la aplicación (para links en emails)
APP_URL=https://dermatologia-stefany.com

# Nombre del sitio
APP_NAME=Dra. Stefany Salinas - Dermatología

# ============================================================================
# 🔒 HTTPS / SSL (opcional, para producción)
# ============================================================================

# Ruta al certificado SSL (si usas HTTPS local)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# ============================================================================
# 📊 GOOGLE ANALYTICS (opcional)
# ============================================================================

# Google Analytics 4 Measurement ID
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ============================================================================
# 📋 INFORMACIÓN DE CONTACTO (para mostrar en emails y sitio)
# ============================================================================

DOCTOR_NAME=Dra. Stefany Salinas
DOCTOR_TITLE=Especialista en Dermatología
DOCTOR_CREDENTIALS=Residente UBA | Médica Clínica Corpas Bogotá

CLINIC_NAME=Dermatología Dra. Stefany Salinas
CLINIC_ADDRESS=Buenos Aires, Argentina
CLINIC_PHONE=+54-11-XXXX-XXXX

# ============================================================================
# 🔧 DESARROLLO
# ============================================================================

# Node environment
NODE_ENV=development

# Base de datos (ruta o conexión)
DATABASE_PATH=./dermatologia.db

# ============================================================================
# 📝 NOTAS IMPORTANTES
# ============================================================================

# 1. SEGURIDAD EN PRODUCCIÓN:
#    - NUNCA hagas commit de este archivo (.env está en .gitignore)
#    - Usa variables de entorno en tu hosting (Railway, Vercel, etc)
#    - Cambia JWT_SECRET por una clave única y fuerte
#    - Usa HTTPS siempre en producción

# 2. SENDGRID:
#    - Cuenta gratuita: 100 emails por día
#    - Para enviar desde dominio personalizado, verifica tu dominio
#    - Almacena las claves en secretos del hosting, no en .env

# 3. EMAIL:
#    - EMAIL_FROM debe estar verificado en SendGrid
#    - Si no está verificado, verás error 403 (Unauthorized)
#    - Puedes usar el sandbox mode para pruebas

# 4. TESTING:
#    - Sin SENDGRID_API_KEY: los emails se simulan en consola
#    - Con SENDGRID_API_KEY: se envían emails reales

# ============================================================================
# 🚀 CONFIGURACIÓN RÁPIDA EN RAILWAY
# ============================================================================

# 1. Crea proyecto en https://railway.app
# 2. Conecta tu repositorio GitHub
# 3. En Variables de Entorno, agrega:
#    JWT_SECRET=tu_clave_secreta
#    SENDGRID_API_KEY=SG.xxxxx
#    EMAIL_FROM=tu_email@verificado.com
#    EMAIL_ADMIN=tu_admin@email.com
# 4. Railway genera HTTPS automáticamente
# 5. Tu app está en producción 🎉

# ============================================================================
